__pycache__/
*.py[cod]
.venv/
venv/
.codex_deps/
.env
credenciais*.json
autenticacao_google.json
# Chaves de conta de servico do Google Cloud (NUNCA versionar)
classificacao-chamados-*.json
*serviceaccount*.json
*-sa.json
# Dados reais do experimento (repo publico — nao versionar conteudo de chamados)
dados/*.json
dados/*.jsonl
# Excecao: marcador da automacao condicionada (apenas contadores inteiros, sem
# nenhum conteudo de chamado) — precisa ser versionado para a guarda comparar runs.
!dados/estado_automacao.json
# Excecao: lista auditavel de IDs do coreset (linha_planilha, id_hash, categoria,
# motivos — SEM texto de chamado nem ID real) — versionada para rastreabilidade.
!dados/bertimbau_coreset_ids.json

# ID da planilha (uso local; nunca versionar)
spreadsheet_id.local

# Detalhamento nao sanitizado de conflitos (uso local; nunca versionar)
*.local.csv

# Fase 2B: arrays de escore grandes e resultados parciais por outer fold —
# somente artifact do GitHub Actions, nunca versionados no Git. Os manifestos
# finais pequenos (fase2b_manifesto/_resumo/_hashes/_proveniencia_run.json) sao
# versionados manualmente depois de as duas execucoes cientificas baterem.
docs/dados/ensemble/fase2b/*.npz
docs/dados/ensemble/fase2b/fase2b_fold_*_fits.json
docs/dados/ensemble/fase2b/fase2b_gate_zero.json
